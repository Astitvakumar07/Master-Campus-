# Browser-safe values. Only Supabase's publishable/anon key belongs in VITE_ variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Private API server values. Never prefix these with VITE_ or put them in client code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
GROQ_API_KEY=server-only-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated exact web origins for production. For local development, localhost is allowed.
APP_ORIGIN=http://localhost:5173
# Set to 1 only when the API is behind a trusted reverse proxy that supplies X-Forwarded-For.
TRUST_PROXY=0
